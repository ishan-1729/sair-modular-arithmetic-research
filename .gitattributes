* text=auto
*.md text eol=lf
*.py text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.pt binary
*.pth binary
*.safetensors binary
*.pdf binary
# Public benchmark hashes describe the exact upstream snapshot bytes.
data/external/public_benchmark/*.jsonl -text -whitespace
# Immutable captures retain source formatting verbatim.
sources/sair-competition/** -whitespace
sources/research/** -whitespace
research/papers/*.pdf filter=lfs diff=lfs merge=lfs -text
