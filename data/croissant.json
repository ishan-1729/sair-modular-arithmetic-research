  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "@id": "problems",
      "name": "Modular arithmetic problems",
      "description": "Homogeneous problem records extracted one JSON object per line from all tier files.",
      "key": [
        { "@id": "problems/tier_id" },
        { "@id": "problems/a" },
        { "@id": "problems/b" },
        { "@id": "problems/p" }
      ],
      "field": [
        {
          "@type": "cr:Field",
          "@id": "problems/a",
          "name": "a",
          "description": "First non-negative operand encoded as a canonical decimal string.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": { "@id": "tier-files" },
            "extract": { "fileProperty": "lines" },
            "transform": { "jsonQuery": "a" }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "problems/b",
          "name": "b",
          "description": "Second non-negative operand encoded as a canonical decimal string.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": { "@id": "tier-files" },
            "extract": { "fileProperty": "lines" },
            "transform": { "jsonQuery": "b" }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "problems/p",
          "name": "p",
          "description": "Prime modulus on scored tiers, encoded as a canonical decimal string.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": { "@id": "tier-files" },
            "extract": { "fileProperty": "lines" },
            "transform": { "jsonQuery": "p" }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "problems/expected",
          "name": "expected",
          "description": "Exact expected answer encoded as a canonical decimal string; evaluation-only.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": { "@id": "tier-files" },
            "extract": { "fileProperty": "lines" },
            "transform": { "jsonQuery": "expected" }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "problems/tier_id",
          "name": "tier_id",
          "description": "Evaluation tier from 0 through 10.",
          "dataType": "sc:Integer",
          "source": {
            "fileSet": { "@id": "tier-files" },
            "extract": { "fileProperty": "lines" },
            "transform": { "jsonQuery": "tier_id" }
          }
        }
      ]
    }
